{
  "info": {
    "_postman_id": "c1f7b8e2-8888-4444-9999-invoicemanagement",
    "name": "Invoice Management System API (Decree 123 Compliant)",
    "description": "Postman Collection for testing Electronic Invoice Management REST API built with Express, TypeScript, PostgreSQL and Prisma ORM.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "invoiceId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "System Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            }
          }
        }
      ]
    },
    {
      "name": "1. Invoice CRUD",
      "item": [
        {
          "name": "1.1 Create Draft Invoice",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.id) {",
                  "    pm.collectionVariables.set('invoiceId', jsonData.data.id);",
                  "    console.log('Saved invoiceId:', jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Công ty Cổ phần Thương mại Alpha\",\n  \"customerTaxCode\": \"0108888888\",\n  \"customerEmail\": \"alpha@example.com\",\n  \"customerAddress\": \"Tầng 8, Tòa nhà Landmark 72, Cầu Giấy, Hà Nội\",\n  \"sellerName\": \"Công ty Cổ phần Giải pháp Phần mềm TechVN\",\n  \"sellerTaxCode\": \"0309876543\",\n  \"sellerAddress\": \"Số 123 Đường Nguyễn Huệ, Quận 1, TP. Hồ Chí Minh\",\n  \"sellerPhone\": \"0901234567\",\n  \"vatRate\": 10,\n  \"notes\": \"Hóa đơn dịch vụ phần mềm quản lý hóa đơn điện tử\",\n  \"items\": [\n    {\n      \"description\": \"Phần mềm quản lý hóa đơn (Gói Doanh Nghiệp)\",\n      \"unit\": \"Gói\",\n      \"quantity\": 1,\n      \"unitPrice\": 15000000\n    },\n    {\n      \"description\": \"Dịch vụ đào tạo và chuyển giao công nghệ\",\n      \"unit\": \"Buổi\",\n      \"quantity\": 2,\n      \"unitPrice\": 2500000\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/invoices",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invoices"]
            }
          }
        },
        {
          "name": "1.2 Get Invoices List (Pagination & Date Filter)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/invoices?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invoices"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "1.3 Search Invoices (Multi-Criteria & Full-Text)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/invoices?search=Alpha&status=ISSUED&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invoices"],
              "query": [
                { "key": "search", "value": "Alpha", "description": "Tìm kiếm theo tên khách hàng, MST, số hóa đơn" },
                { "key": "status", "value": "ISSUED", "description": "Lọc trạng thái (DRAFT, ISSUED, CANCELED, REPLACED)" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "1.4 Get Invoice Detail by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/invoices/{{invoiceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invoices", "{{invoiceId}}"]
            }
          }
        },
        {
          "name": "1.5 Update Draft Invoice",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Công ty Cổ phần Thương mại Alpha (Cập Nhật)\",\n  \"vatRate\": 8,\n  \"items\": [\n    {\n      \"description\": \"Phần mềm quản lý hóa đơn (Gói Doanh Nghiệp Nâng Cấp)\",\n      \"unit\": \"Gói\",\n      \"quantity\": 1,\n      \"unitPrice\": 18000000\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/invoices/{{invoiceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invoices", "{{invoiceId}}"]
            }
          }
        },
        {
          "name": "1.6 Clone Invoice to Draft",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/invoices/{{invoiceId}}/clone",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invoices", "{{invoiceId}}", "clone"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Invoice Lifecycle Operations",
      "item": [
        {
          "name": "2.1 Issue/Sign Invoice & Request Tax Authority Code (Cấp Mã CQT)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/invoices/{{invoiceId}}/issue",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invoices", "{{invoiceId}}", "issue"]
            }
          }
        },
        {
          "name": "2.2 Replace Invoice (ISSUED -> REPLACED)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.id) {",
                  "    pm.collectionVariables.set('invoiceId', jsonData.data.id);",
                  "    console.log('Updated invoiceId to replacement:', jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Công ty Cổ phần Thương mại Alpha (Thay Thế)\",\n  \"customerTaxCode\": \"0108888888\",\n  \"customerEmail\": \"alpha@example.com\",\n  \"customerAddress\": \"Tầng 8, Tòa nhà Landmark 72, Cầu Giấy, Hà Nội\",\n  \"sellerName\": \"Công ty Cổ phần Giải pháp Phần mềm TechVN\",\n  \"sellerTaxCode\": \"0309876543\",\n  \"sellerAddress\": \"Số 123 Đường Nguyễn Huệ, Quận 1, TP. Hồ Chí Minh\",\n  \"sellerPhone\": \"0901234567\",\n  \"vatRate\": 10,\n  \"agreementMinutes\": \"01/BB-TT\",\n  \"notes\": \"Hóa đơn thay thế do sai sót đơn giá\",\n  \"items\": [\n    {\n      \"description\": \"Phần mềm quản lý hóa đơn (Gói Doanh Nghiệp Chuẩn)\",\n      \"unit\": \"Gói\",\n      \"quantity\": 1,\n      \"unitPrice\": 16000000\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/invoices/{{invoiceId}}/replace",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invoices", "{{invoiceId}}", "replace"]
            }
          }
        },
        {
          "name": "2.3 Cancel Invoice (ISSUED -> CANCELED)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cancelReason\": \"Hủy theo biên bản thỏa thuận số 01/BB-HUY giữa hai bên do hủy hợp đồng cung cấp dịch vụ\",\n  \"agreementMinutes\": \"01/BB-HUY\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/invoices/{{invoiceId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invoices", "{{invoiceId}}", "cancel"]
            }
          }
        }
      ]
    },
    {
      "name": "3. PDF Export & Download",
      "item": [
        {
          "name": "3.1 Preview PDF Stream",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/invoices/{{invoiceId}}/pdf",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invoices", "{{invoiceId}}", "pdf"]
            }
          }
        },
        {
          "name": "3.2 Download PDF Attachment",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/invoices/{{invoiceId}}/pdf?download=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invoices", "{{invoiceId}}", "pdf"],
              "query": [
                { "key": "download", "value": "true" }
              ]
